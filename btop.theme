# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#000000"

# Main text color
theme[main_fg]="#97D863"

# Title color for boxes
theme[title]="#97D863"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#667ab9"

# Background color of selected item in processes box. #1a1a1a maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1a1a1a gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1a1a1a"

# Foreground color of selected item in processes box. Use #97D863 so
# the row text stays readable on the lighter_bg highlight; the previous
# #667ab9 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#97D863"

# Color of inactive/disabled text
theme[inactive_fg]="#686163"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #a7de7a caps at #ffffff when the foreground is already pure white, so we
# just bind it to #97D863 directly.
theme[graph_text]="#97D863"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #1a1a1a collapsed to the main fg.
theme[meter_bg]="#1a1a1a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #8fdcff for a distinct accent instead of #a7de7a which capped to white.
theme[proc_misc]="#8fdcff"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#a19ef1"
theme[mem_box]="#76cafe"
theme[net_box]="#9c86c2"
theme[proc_box]="#667ab9"

# Box divider line and small boxes line color
theme[div_line]="#686163"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#76cafe"
theme[temp_mid]="#89ffff"
theme[temp_end]="#9c86c2"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#8fdcff"
theme[cpu_mid]="#667ab9"
theme[cpu_end]="#a19ef1"

# Mem/Disk free meter
theme[free_start]="#a19ef1"
theme[free_mid]="#667ab9"
theme[free_end]="#8fdcff"

# Mem/Disk cached meter
theme[cached_start]="#667ab9"
theme[cached_mid]="#8fdcff"
theme[cached_end]="#a19ef1"

# Mem/Disk available meter
theme[available_start]="#89ffff"
theme[available_mid]="#9c86c2"
theme[available_end]="#9c86c2"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#76cafe"
theme[used_mid]="#8fdcff"
theme[used_end]="#667ab9"

# Download graph colors
theme[download_start]="#89ffff"
theme[download_mid]="#9c86c2"
theme[download_end]="#9c86c2"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#76cafe"
theme[upload_mid]="#8fdcff"
theme[upload_end]="#667ab9"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#8fdcff"
theme[process_mid]="#667ab9"
theme[process_end]="#a19ef1"
